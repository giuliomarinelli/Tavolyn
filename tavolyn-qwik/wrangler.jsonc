{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tavolyn",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/api/*", "/app", "/app/*"],
  },
  "observability": {
    "enabled": true,
  },
}
