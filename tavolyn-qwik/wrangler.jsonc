{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tavolyn",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "secrets": { "required": ["ORDER_TOKEN_KEY"] },
  "vars": {
    "LOCAL_DEMO_MODE": "false",
  },
  // Local database name only. No remote database or UUID has been provisioned.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tavolyn-local",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/api/*", "/app", "/app/*"],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
}
