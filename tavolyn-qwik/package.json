{
  "name": "tavolyn-qwik",
  "description": "Tavolyn portfolio demo: Qwik City on one Cloudflare Worker",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build && wrangler deploy --dry-run --outdir .wrangler/build",
    "build.client": "vite build",
    "build.server": "qwik check-client src dist && vite build --config adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --include-runtime false --strict-vars false",
    "dev": "npm run cf:dev",
    "cf:dev": "npm run build && npm run preview",
    "dev:vite": "vite --mode ssr",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint src tests scripts adapters vite.config.ts vitest.config.ts playwright.config.ts playwright.auth.config.ts",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8787 --var LOCAL_DEMO_MODE:true --log-level warn",
    "history:backfill": "wrangler d1 execute DB --local --file migrations/0004_tracking_outbox.sql",
    "email:capture": "vite build --config scripts/email-sink.config.ts && node .wrangler/email-sink/capture.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file seeds/demo-tenants.sql && wrangler d1 execute DB --local --file seeds/demo-catalog.sql && wrangler d1 execute DB --local --file seeds/demo-checkout.sql && wrangler d1 execute DB --local --file seeds/demo-staff.sql",
    "checkout:setup": "node scripts/setup-checkout.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:browser": "playwright test && npm run test:auth:browser",
    "benchmark": "node scripts/benchmark-worker.mjs",
    "qwik": "qwik",
    "auth:preview": "vite build --config tests/oidc/harness.config.ts && node .wrangler/oidc-harness/start.mjs",
    "test:auth:browser": "playwright test --config playwright.auth.config.ts"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@cloudflare/workers-types": "5.20261115.1",
    "@eslint/js": "^9",
    "@playwright/test": "1.65.1",
    "@types/node": "20.19.0",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "1.20.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "vite": "7.3.8",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "4.1.12",
    "wrangler": "4.162.0",
    "ws": "8.21.0"
  },
  "dependencies": {
    "oauth4webapi": "3.8.8"
  }
}
