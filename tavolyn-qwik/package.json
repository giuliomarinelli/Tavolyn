{
  "name": "tavolyn-qwik",
  "description": "Tavolyn portfolio demo: Qwik City on one Cloudflare Worker",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build && wrangler deploy --dry-run --outdir .wrangler/build",
    "build.client": "vite build",
    "build.server": "qwik check-client src dist && vite build --config adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --include-runtime false",
    "dev": "npm run build && npm run preview",
    "dev:vite": "vite --mode ssr",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint src tests scripts adapters vite.config.ts vitest.config.ts",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test": "vitest run",
    "benchmark": "node scripts/benchmark-worker.mjs",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@cloudflare/workers-types": "5.20261115.1",
    "@eslint/js": "^9",
    "@types/node": "20.19.0",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "1.20.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "vite": "7.3.8",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "4.1.12",
    "wrangler": "4.162.0",
    "ws": "8.21.0"
  }
}
